# Use different random 32-byte hex values. Example generator:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
WORKSPACE_TOKEN=
WORKER_TOKEN=
WORKSPACE_HOST=127.0.0.1
WORKSPACE_PORT=4178
# Set to the exact HTTPS origin printed by `tailscale serve 4178`.
# WORKSPACE_PUBLIC_URL=https://laptop.example-tailnet.ts.net
# Optional repository locations for a different checkout or macOS:
# WORKSPACE_REPO_MOMENTORY_FE=/path/to/momentory-fe
# WORKSPACE_REPO_MOMENTORY_BE=/path/to/momentory-be
